{
  "name": "flow-ds-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentación pública del Flow Design System — consume @flowds/* publicados desde npm.",
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs && node scripts/gen-props.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flowds/design-system": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
